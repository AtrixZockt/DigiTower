<UserControl x:Class="DcsAtc.Gui.Views.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,24,28,28">
            <TextBlock Style="{StaticResource PageTitle}" Text="Install" />
            <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,18"
                       Text="The bridge goes into each DCS's Saved Games folder: it lets DigiTower see the mission and talk to the pilots. DCS loads it when it starts." />

            <Border Background="{StaticResource ErrorWell}" BorderBrush="{StaticResource ErrorEdge}" BorderThickness="1" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding Problem, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="{Binding Problem}" Foreground="{StaticResource ErrorText}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{StaticResource WarnWell}" BorderBrush="{StaticResource WarnEdge}" BorderThickness="1" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding DcsRunning, Converter={StaticResource VisibleWhen}}">
                <TextBlock Foreground="{StaticResource WarnText}" TextWrapping="Wrap"
                           Text="DCS is running. It reads the bridge and its settings when it starts: restart it after a change here." />
            </Border>

            <!-- The DCS folders. -->
            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="DCS FOLDERS" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8">
                        <Run Text="Found in " /><Run Text="{Binding SavedGames, Mode=OneWay}" /><Run Text=". The server needs it; a client only for single player and hosting from the game." />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Instances}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="0,14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="330" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,20,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBright}" VerticalAlignment="Center" />
                                                    <Border Background="{Binding StateBack}" BorderBrush="{Binding StateEdge}" BorderThickness="1" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding State}" Foreground="{Binding StateText}" FontSize="11" FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMid}" />
                                                <TextBlock Text="{Binding Warning}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource WarnText}"
                                                           Visibility="{Binding Warning, Converter={StaticResource VisibleWhen}}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{StaticResource Bg}" BorderBrush="{StaticResource EdgeSoft}" BorderThickness="1" Padding="12,10" Margin="0,0,20,0">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Caption}" Text="BRIDGE SETTINGS (DigiTowerConfig.lua)" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="80" AutomationProperties.Name="Bridge port" />
                                                    </StackPanel>
                                                    <CheckBox Content="DigiTower handles AI traffic" IsChecked="{Binding ManageAi}" Margin="0,10,0,0"
                                                              ToolTip="AI departures wait at parking and AI arrivals hold in the air while players use the airfield; AI pilots talk" />
                                                    <CheckBox Content="F10 map drawings" IsChecked="{Binding MapDrawings}" Margin="0,8,0,0" />
                                                    <Button Content="SAVE BRIDGE SETTINGS" Command="{Binding ApplySettingsCommand}" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                            Visibility="{Binding SettingsChanged, Converter={StaticResource VisibleWhen}}" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Grid.Column="2" Width="140">
                                                <Button Content="{Binding Primary}" Command="{Binding InstallCommand}" Style="{StaticResource PrimaryButton}" MinHeight="40"
                                                        Visibility="{Binding PrimaryIsAccent, Converter={StaticResource VisibleWhen}}" />
                                                <Button Content="{Binding Primary}" Command="{Binding InstallCommand}" MinHeight="40"
                                                        Visibility="{Binding PrimaryIsAccent, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                                                <Button Content="UNINSTALL" Command="{Binding UninstallCommand}" Margin="0,8,0,0"
                                                        Visibility="{Binding Installed, Converter={StaticResource VisibleWhen}}" />
                                                <Button Content="FORGET FOLDER" Command="{Binding ForgetCommand}" Margin="0,8,0,0" ToolTip="Takes it off this list (nothing is deleted)"
                                                        Visibility="{Binding AddedByHand, Converter={StaticResource VisibleWhen}}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Message}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource AccentBright}"
                                                   Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No DCS folder found in Saved Games." Foreground="{StaticResource TextDim}" Margin="0,8"
                               Visibility="{Binding Instances.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                    <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add a Saved Games folder…" Command="{Binding AddFolderCommand}" />
                            <TextBlock Style="{StaticResource Hint}" Text="For a DCS whose Saved Games folder is somewhere else." VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- The models. -->
            <Border Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="VOICES AND SPEECH RECOGNITION" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12">
                        <Run Text="Downloaded to " /><Run Text="{Binding ModelsFolder, Mode=OneWay}" /><Run Text=". Read each license: some voices are for private use only. The Windows voices need no download." />
                    </TextBlock>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Caption}" Text="MODEL" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="USED FOR" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="SIZE" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="STATE" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Models}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource EdgeSoft}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding License}" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Use}" TextWrapping="Wrap" Foreground="{StaticResource TextMid}" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Mono}" FontSize="12" />
                                        <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" ToolTip="{Binding ToolTip}" />
                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Margin="0,6,0,0" IsIndeterminate="{Binding Unpacking, Mode=OneWay}"
                                                         Visibility="{Binding Busy, Converter={StaticResource VisibleWhen}}" />
                                        </StackPanel>
                                        <Button Grid.Column="4" Content="{Binding Action}" Command="{Binding ActCommand}" VerticalAlignment="Top"
                                                Visibility="{Binding HasAction, Converter={StaticResource VisibleWhen}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No voices or recognizers listed (data\voice not found)." Foreground="{StaticResource TextDim}" Margin="0,8"
                               Visibility="{Binding Models.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
