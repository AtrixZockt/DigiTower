<UserControl x:Class="DcsAtc.Gui.Views.OperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Airfield tabs. -->
        <Style x:Key="AirfieldTab" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMid}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Box" Background="Transparent" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0" MinHeight="44" Padding="18,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#313130" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Raised}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBright}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A flight progress strip. -->
        <DataTemplate x:Key="StripTemplate">
            <Border Background="{StaticResource StripPaper}" MinHeight="58" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="58" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding TagBrush}">
                        <TextBlock Text="{Binding Tag}" Foreground="{Binding TagTextBrush}" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,6">
                        <WrapPanel>
                            <TextBlock Text="{Binding Callsign}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource StripInk}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Type}" FontSize="12" Foreground="{StaticResource StripInkSoft}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Clearance}" FontSize="12" Margin="0,2,0,0" Foreground="#2F2E2B" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Note}" FontSize="12" Margin="0,2,0,0" FontWeight="Bold" Foreground="{StaticResource StripNote}" TextWrapping="Wrap"
                                   Visibility="{Binding Note, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                    <Line Grid.Column="1" HorizontalAlignment="Right" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill" Stroke="{StaticResource StripRule}" StrokeDashArray="3,3" />
                    <Grid Grid.Column="2" Margin="8,6">
                        <TextBlock Text="{Binding Runway}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource StripInk}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Elapsed}" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource StripInkSoft}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,24,28,28">

            <!-- The mission, how long the ATC has run, start / stop. -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Caption}" />
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center" Visibility="{Binding Main.Running, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Style="{StaticResource Caption}" Text="RUNNING" HorizontalAlignment="Right" />
                        <TextBlock Style="{StaticResource Mono}" FontSize="18" Text="{Binding Main.Elapsed}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Style="{StaticResource DangerButton}" Content="STOP ATC" MinHeight="44" Padding="22,0" FontSize="15" Command="{Binding Main.StartStopCommand}"
                            Visibility="{Binding Main.Running, Converter={StaticResource VisibleWhen}}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="START ATC" MinHeight="44" Padding="22,0" FontSize="15" Command="{Binding Main.StartStopCommand}"
                            Visibility="{Binding Main.Running, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                </StackPanel>
            </Grid>

            <!-- Status lights. -->
            <ItemsControl ItemsSource="{Binding Main.Lights}" Margin="0,0,-8,20" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Back}" BorderBrush="{Binding Edge}" BorderThickness="1" Padding="12,10" MinHeight="64" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Foreground="{Binding LabelBrush}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="{Binding Text}" Foreground="{Binding TextBrush}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The airfields and their strips. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox ItemsSource="{Binding Airfields}" SelectedItem="{Binding Selected}" Style="{StaticResource PlainList}"
                                 Visibility="{Binding Airfields.Count, Converter={StaticResource VisibleWhen}}"
                                 ItemContainerStyle="{StaticResource AirfieldTab}" AutomationProperties.Name="Airfields"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource Mono}" FontWeight="Normal" FontSize="12" Foreground="{StaticResource TextDim}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Column="1" Text="{Binding Atis}" FontSize="12" Foreground="{StaticResource TextDim}" Margin="16,0" VerticalAlignment="Center" />
                    </Grid>
                    <Border BorderBrush="{StaticResource Edge}" BorderThickness="{Binding Airfields.Count, Converter={StaticResource TopRuleWhen}}">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Columns}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0" Padding="14" MinHeight="180">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
                                                    <TextBlock Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource AccentBright}" Text="{Binding Frequency}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Strips}" ItemTemplate="{StaticResource StripTemplate}" Focusable="False" />
                                                <TextBlock Text="No traffic" FontSize="12" Foreground="{StaticResource TextFaint}"
                                                           Visibility="{Binding Strips.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding EmptyMessage}" Visibility="{Binding EmptyMessage, Converter={StaticResource VisibleWhen}}"
                                       Margin="16,60" HorizontalAlignment="Center" FontSize="15" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" TextAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- The latest log lines. -->
            <Border Background="{StaticResource Well}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                <StackPanel>
                    <Border BorderBrush="{StaticResource EdgeSoft}" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="RECENT" />
                            <Button Style="{StaticResource LinkButton}" Content="Open log" HorizontalAlignment="Right" FontSize="13" Command="{Binding OpenLogCommand}" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Recent}" Margin="14,8,14,12" Focusable="False" MinHeight="40">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource TextFaint}" Text="{Binding Time}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="12.5" Foreground="{Binding CategoryBrush}" Text="{Binding Category}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="12.5" Foreground="{Binding TextBrush}" Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
