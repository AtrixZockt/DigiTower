<UserControl x:Class="DcsAtc.Gui.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <TextBlock Style="{StaticResource PageTitle}" Text="Log" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ToggleButton Style="{StaticResource FollowToggle}" IsChecked="{Binding Following}" Content="{Binding FollowText}" Margin="0,0,8,0"
                              ToolTip="Following: new lines scroll into view. Scrolling up pauses." />
                <Button Content="COPY" Command="{Binding CopyCommand}" Margin="0,0,8,0" ToolTip="Copies the lines shown (Ctrl+C copies the selected ones)" />
                <Button Content="OPEN LOG FOLDER" Command="{Binding OpenFolderCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- The log: category chips, filters, lines. -->
            <Border Background="{StaticResource Well}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="0,0,20,0">
                <DockPanel>
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Categories}" Margin="14,14,8,8" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Shown}" AutomationProperties.Name="{Binding Name}"
                                              ToolTip="Shown here and in the console (a setting)">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" />
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource Mono}" FontWeight="Normal" FontSize="11" Margin="7,0,0,0"
                                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource EdgeSoft}" BorderThickness="0,0,0,1" Padding="14,0,14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MaxWidth="420" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Caption}" Text="SEARCH" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" AutomationProperties.Name="Search the log" />
                                <TextBlock Text="callsign, runway, text …" Foreground="{StaticResource TextFaint}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                            </Grid>
                            <CheckBox Grid.Column="2" Content="Warnings only" IsChecked="{Binding WarningsOnly}" Margin="20,0,0,0" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="3" Content="Debug" IsChecked="{Binding Debug}" Margin="20,0,0,0" VerticalAlignment="Center"
                                      ToolTip="Also the debug lines: clips prepared, status every 10 seconds (a setting)" />
                        </Grid>
                    </Border>

                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ShownText}" FontSize="12" Foreground="{StaticResource TextDim}" Margin="14,8,14,10" />

                    <Grid>
                        <ListBox x:Name="Lines" ItemsSource="{Binding Lines}" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource LogRow}"
                                 SelectionMode="Extended" Padding="0,6" AutomationProperties.Name="Log lines"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="{Binding RowBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource TextFaint}" Text="{Binding Time}" Margin="0,2" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="12.5" Foreground="{Binding CategoryBrush}" Text="{Binding Category}" Margin="0,2" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="12.5" Foreground="{Binding TextBrush}" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource TextDim}" Margin="14" IsHitTestVisible="False"
                                   Visibility="{Binding Lines.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- What is logged where (settings). -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="WHAT IS LOGGED" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,14"
                               Text="Shown: in this window and in DigiTowerConsole. File: in the log file. Both apply at once and are saved in the settings." />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Caption}" Text="CATEGORY" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="SHOWN" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="FILE" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource EdgeSoft}" BorderThickness="0,1,0,0" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Shown}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} shown}" />
                                        <CheckBox Grid.Column="2" IsChecked="{Binding InFile}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} in the log file}"
                                                  IsEnabled="{Binding DataContext.WriteFile, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <CheckBox Content="Write a log file" IsChecked="{Binding WriteFile}" Margin="0,16,0,0" />
                    <TextBlock Style="{StaticResource Caption}" Text="TODAY'S LOG FILE" Margin="0,14,0,4" />
                    <TextBox Text="{Binding LogFile, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Keep log files for" VerticalAlignment="Center" />
                        <TextBox Text="{Binding KeepDays, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="56" Margin="10,0" HorizontalContentAlignment="Right"
                                 AutomationProperties.Name="Days to keep log files" />
                        <TextBlock Text="days" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
